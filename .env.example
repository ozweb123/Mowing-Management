# Miles Mowing Management — environment template
# Copy to .env.local and adjust. Never commit real secrets.

# Session signing secret (min 32 chars). Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Default PIN for first-time setup (4–8 digits). Change after first login.
DEFAULT_PIN=2468

# Southwest Topeka, KS coordinates (Open-Meteo)
WEATHER_LAT=39.0375
WEATHER_LON=-95.7250
WEATHER_TIMEZONE=America/Chicago

# Set to 1 only behind a reverse proxy that sets X-Forwarded-For correctly.
# TRUST_PROXY=1

# Optional: bind host in production
# PORT=3000
